;;; neo-diredy-actions-tests.el --- Single and bulk file actions -*- lexical-binding: t; -*-
(unless (boundp 'neo-diredy-test-root)
  (load (expand-file-name "neo-diredy-tests.el" (file-name-directory load-file-name)) nil t))
(require 'dired-aux)
(defvar neo-diredy--clipboard)
(defvar neo-diredy--action-results)

(defmacro neo-diredy-actions--with-files (&rest body)
  `(neo-diredy-test--with-directory
    (let ((neo-diredy--clipboard nil) (neo-diredy--action-results nil)
          (delete-by-moving-to-trash nil) (dired-backup-overwrite nil)
          (make-backup-files nil) (create-lockfiles nil)
          (dired-vc-rename-file nil))
      (dired-goto-file file)
      ,@body)))

(defun neo-diredy-actions--contents (path)
  (with-temp-buffer (insert-file-contents path) (buffer-string)))

(ert-deftest neo-diredy-actions-targets-prefer-marks-and-ignore-delete-flags ()
  (neo-diredy-actions--with-files
   (should (equal (neo-diredy--action-targets) (list file)))
   (dired-mark 1)
   (dired-goto-file child)
   (should (equal (neo-diredy--action-targets) (list file)))
   (dired-flag-file-deletion 1)
   (should (equal (neo-diredy--action-targets) (list file)))
   (dired-goto-file file) (dired-unmark 1)
   (dired-goto-file child)
   (should (equal (neo-diredy--action-targets) (list child)))))

(ert-deftest neo-diredy-actions-empty-and-wdired-are-not-action-targets ()
  (neo-diredy-actions--with-files
   (dired child)
   (should-not (neo-diredy--action-targets))
   (should-error (neo-diredy-copy) :type 'user-error)
   (dired root) (dired-goto-file file)
   (wdired-change-to-wdired-mode)
   (unwind-protect (should-error (neo-diredy-cut) :type 'user-error)
     (wdired-abort-changes))))

(ert-deftest neo-diredy-actions-copy-paste-retains-clipboard ()
  (neo-diredy-actions--with-files
   (neo-diredy-copy)
   (should (equal neo-diredy--clipboard (cons 'copy (list file))))
   (dired child)
   (neo-diredy-paste)
   (should (equal (neo-diredy-actions--contents (expand-file-name "hello.txt" child)) "hello preview\n"))
   (should (file-exists-p file))
   (should (equal (cdr neo-diredy--clipboard) (list file)))
   (should (equal (mapcar #'cadr neo-diredy--action-results) '(done)))))

(ert-deftest neo-diredy-actions-cut-defers-and-consumes-only-success ()
  (neo-diredy-actions--with-files
   (let ((missing (expand-file-name "missing.txt" root)))
     (neo-diredy-cut)
     (should (file-exists-p file))
     (setq neo-diredy--clipboard (cons 'cut (list file missing)))
     (dired child)
     (neo-diredy-paste)
     (should-not (file-exists-p file))
     (should (file-exists-p (expand-file-name "hello.txt" child)))
     (should (equal neo-diredy--clipboard (cons 'cut (list missing))))
     (should (equal (mapcar #'cadr neo-diredy--action-results) '(done failed))))))

(ert-deftest neo-diredy-actions-conflict-skip-and-rename ()
  (neo-diredy-actions--with-files
   (with-temp-file (expand-file-name "hello.txt" child) (insert "keep"))
   (neo-diredy-cut) (dired child)
   (cl-letf (((symbol-function 'neo-diredy--action-conflict) (lambda (&rest _) 'skip)))
     (neo-diredy-paste))
   (should (equal (neo-diredy-actions--contents (expand-file-name "hello.txt" child)) "keep"))
   (should (file-exists-p file))
   (cl-letf (((symbol-function 'neo-diredy--action-conflict)
              (lambda (&rest _) (expand-file-name "日本語 renamed.txt" child))))
     (neo-diredy-paste))
   (should-not neo-diredy--clipboard)
   (should (file-exists-p (expand-file-name "日本語 renamed.txt" child)))))

(ert-deftest neo-diredy-actions-conflict-overwrite-and-directory-no-merge ()
  (neo-diredy-actions--with-files
   (with-temp-file (expand-file-name "hello.txt" child) (insert "old"))
   (neo-diredy-copy) (dired child)
   (cl-letf (((symbol-function 'neo-diredy--action-conflict) (lambda (&rest _) 'overwrite)))
     (neo-diredy-paste))
   (should (equal (neo-diredy-actions--contents (expand-file-name "hello.txt" child)) "hello preview\n"))
   (let ((source (expand-file-name "folder" root)) (dest (expand-file-name "folder" child)))
     (make-directory source) (make-directory dest)
     (with-temp-file (expand-file-name "only-source" source) (insert "source"))
     (setq neo-diredy--clipboard (cons 'copy (list source)))
     (cl-letf (((symbol-function 'neo-diredy--action-conflict)
                (lambda (_from _to overwrite) (should-not overwrite) 'skip)))
       (neo-diredy-paste))
     (should-not (file-exists-p (expand-file-name "only-source" dest))))))

(ert-deftest neo-diredy-actions-refuse-self-and-descendant ()
  (neo-diredy-actions--with-files
   (neo-diredy-copy) (neo-diredy-paste)
   (should (equal (mapcar #'cadr neo-diredy--action-results) '(failed)))
   (should (equal (neo-diredy-actions--contents file) "hello preview\n"))
   (setq neo-diredy--clipboard (cons 'cut (list root)))
   (dired child) (neo-diredy-paste)
   (should (equal (mapcar #'cadr neo-diredy--action-results) '(failed)))
   (should (file-exists-p file))))

(ert-deftest neo-diredy-actions-collapse-nested-selection ()
  (neo-diredy-actions--with-files
   (let ((nested (expand-file-name "nested.txt" child)))
     (with-temp-file nested (insert "nested"))
     (dired-insert-subdir child)
     (dired-goto-file child) (dired-mark 1)
     (dired-goto-file nested) (dired-mark 1)
     (should (= (length (neo-diredy--action-targets)) 2))
     (should (equal (neo-diredy--action-targets t) (list child))))))

(ert-deftest neo-diredy-actions-copy-directory-and-unicode ()
  (neo-diredy-actions--with-files
   (let* ((source (expand-file-name "日本語 & 100%" root))
          (inside (expand-file-name "nested.txt" source)))
     (make-directory source) (with-temp-file inside (insert "inside"))
     (setq neo-diredy--clipboard (cons 'copy (list source)))
     (dired child) (neo-diredy-paste)
     (should (equal (neo-diredy-actions--contents (expand-file-name "日本語 & 100%/nested.txt" child)) "inside")))))

(ert-deftest neo-diredy-actions-quit-retains-unprocessed-cut-items ()
  (neo-diredy-actions--with-files
   (let ((second (expand-file-name "second" root)) (original (symbol-function 'dired-rename-file)))
     (with-temp-file second (insert "second"))
     (setq neo-diredy--clipboard (cons 'cut (list file second)))
     (dired child)
     (cl-letf (((symbol-function 'dired-rename-file)
                (lambda (from to overwrite)
                  (if (equal from second) (signal 'quit nil) (funcall original from to overwrite)))))
       (neo-diredy-paste))
     (should (equal (cdr neo-diredy--clipboard) (list second)))
     (should (equal (mapcar #'cadr neo-diredy--action-results) '(done pending)))
     (should (file-exists-p second)))))

(ert-deftest neo-diredy-actions-delete-cancel-and-trash-failure ()
  (neo-diredy-actions--with-files
   (cl-letf (((symbol-function 'neo-diredy--confirm-delete) (lambda (&rest _) nil)))
     (neo-diredy-delete))
   (should (file-exists-p file))
   (let ((delete-by-moving-to-trash t))
     (cl-letf (((symbol-function 'neo-diredy--confirm-delete) (lambda (&rest _) t))
               ((symbol-function 'move-file-to-trash) (lambda (&rest _) (error "trash unavailable"))))
       (neo-diredy-delete)))
   (should (file-exists-p file))
   (should (equal (mapcar #'cadr neo-diredy--action-results) '(failed)))))

(ert-deftest neo-diredy-actions-delete-marked-files-preserves-unsaved-buffer ()
  (neo-diredy-actions--with-files
   (let ((edited (find-file-noselect file)))
     (with-current-buffer edited (goto-char (point-max)) (insert "unsaved"))
     (dired-goto-file file) (dired-mark 1)
     (cl-letf (((symbol-function 'neo-diredy--confirm-delete) (lambda (&rest _) t)))
       (neo-diredy-delete))
     (should-not (file-exists-p file))
     (should (buffer-live-p edited))
     (should (buffer-modified-p edited))
     (should (with-current-buffer edited (string-suffix-p "unsaved" (buffer-string)))))))

(ert-deftest neo-diredy-actions-symlink-copy-preserves-link ()
  (neo-diredy-actions--with-files
   (let ((link (expand-file-name "link.txt" root)))
     (condition-case nil (make-symbolic-link file link) (file-error (ert-skip "Symlink privilege unavailable")))
     (setq neo-diredy--clipboard (cons 'copy (list link)))
     (dired child) (neo-diredy-paste)
     (should (file-symlink-p (expand-file-name "link.txt" child))))))

(ert-deftest neo-diredy-actions-move-preserves-unsaved-buffer-and-marks ()
  (neo-diredy-actions--with-files
   (let ((edited (find-file-noselect file)) (dest (expand-file-name "hello.txt" child)))
     (with-current-buffer edited (goto-char (point-max)) (insert "unsaved"))
     (neo-diredy-cut) (dired child)
     (with-temp-file (expand-file-name "keep.txt" child) (insert "keep"))
     (revert-buffer nil t) (dired-goto-file (expand-file-name "keep.txt" child)) (dired-mark 1)
     (neo-diredy-paste)
     (should (buffer-live-p edited))
     (should (with-current-buffer edited (and (buffer-modified-p) (equal buffer-file-name dest)
                                             (string-suffix-p "unsaved" (buffer-string)))))
     (should (equal (neo-diredy--action-marks) (list (expand-file-name "keep.txt" child)))))))

(ert-deftest neo-diredy-actions-duplicate-basenames-require-conflict-choice ()
  (neo-diredy-actions--with-files
   (let ((other (expand-file-name "other/hello.txt" root)) (asked 0))
     (make-directory (file-name-directory other)) (with-temp-file other (insert "second"))
     (setq neo-diredy--clipboard (cons 'cut (list file other))) (dired child)
     (cl-letf (((symbol-function 'neo-diredy--action-conflict)
                (lambda (&rest _) (cl-incf asked) 'skip)))
       (neo-diredy-paste))
     (should (= asked 1))
     (should (equal (neo-diredy-actions--contents (expand-file-name "hello.txt" child)) "hello preview\n"))
     (should (equal neo-diredy--clipboard (cons 'cut (list other)))))))

(ert-deftest neo-diredy-actions-partial-copy-error-is-visible-and-keeps-source ()
  (neo-diredy-actions--with-files
   (neo-diredy-copy) (dired child)
   (cl-letf (((symbol-function 'dired-copy-file)
              (lambda (_from to _overwrite) (with-temp-file to (insert "partial")) (error "Disk full"))))
     (neo-diredy-paste))
   (should (file-exists-p file))
   (should (equal (cadar neo-diredy--action-results) 'failed))
   (should (string-match-p "partial data" (nth 3 (car neo-diredy--action-results))))))

(ert-deftest neo-diredy-actions-overwrite-all-cannot-replace-earlier-batch-output ()
  (neo-diredy-actions--with-files
   (let ((other (expand-file-name "other/hello.txt" root)) (asked 0))
     (make-directory (file-name-directory other)) (with-temp-file other (insert "second"))
     (with-temp-file (expand-file-name "hello.txt" child) (insert "existing"))
     (setq neo-diredy--clipboard (cons 'cut (list file other))) (dired child)
     (cl-letf (((symbol-function 'neo-diredy--action-conflict)
                (lambda (&rest _) (if (= (cl-incf asked) 1) 'overwrite-all 'skip))))
       (neo-diredy-paste))
     (should (= asked 2))
     (should (equal (neo-diredy-actions--contents (expand-file-name "hello.txt" child)) "hello preview\n"))
     (should (file-exists-p other))
     (should (equal neo-diredy--clipboard (cons 'cut (list other)))))))

(ert-deftest neo-diredy-actions-hidden-marks-stay-targeted ()
  (neo-diredy-actions--with-files
   (let ((nested (expand-file-name "nested.txt" child)))
     (with-temp-file nested (insert "nested"))
     (dired-insert-subdir child) (dired-goto-file nested) (dired-mark 1)
     (dired-hide-subdir 1) (dired-goto-file file)
     (should (equal (neo-diredy--action-targets) (list nested))))))
