(ert-deftest neo-diredy-details-live-git-keeps-content-cache-independent ()
  (neo-diredy-test--with-directory
   (dired-goto-file file)
   (neo-diredy--layout-mode 1)
   (let* ((neo-diredy-git-status t)
          (neo-diredy--git-location default-directory)
          (states (make-hash-table :test #'equal))
          (neo-diredy--git-state (cons "main" states))
          (cached (copy-tree neo-diredy--details-cache)))
     (puthash file " M" states)
     (neo-diredy--metadata-paint)
     (should (string-match-p "Git \\[ M\\] main" (with-current-buffer neo-diredy--details-buffer (buffer-string))))
     (puthash file "M " states)
     (neo-diredy--metadata-paint)
     (should (string-match-p "Git \\[M \\] main" (with-current-buffer neo-diredy--details-buffer (buffer-string))))
     (should (equal cached neo-diredy--details-cache))
     (should-not (plist-get neo-diredy--details-data :git))
     (dired-goto-file child)
     (neo-diredy--refresh)
     (let ((footer (with-current-buffer neo-diredy--details-buffer (buffer-string))))
       (should (string-match-p "Git main" footer))
       (should-not (string-match-p "M \\]\\|clean" footer)))
     (setq neo-diredy--git-state nil)
     (neo-diredy--metadata-paint)
     (should-not (string-match-p "Git" (with-current-buffer neo-diredy--details-buffer (buffer-string)))))))

(ert-deftest neo-diredy-details-long-branch-and-compact-git ()
  (let* ((data (list :format "Directory" :size "2 KiB" :git "Git [ M]"
                     :branch (make-string 200 ?x) :extra '("h264" "30 fps")))
         (lines (neo-diredy--details-lines data 24))
         (compact (neo-diredy--details-compact data 24)))
    (should (= 3 (length lines)))
    (should (cl-every (lambda (line) (<= (string-width line) 24)) lines))
    (should (string-prefix-p "Git [ M]" (nth 2 lines)))
    (should (string-prefix-p "Git [ M]" compact))
    (should (string-match-p "2 KiB" compact))
    (should (<= (string-width compact) 24))))
