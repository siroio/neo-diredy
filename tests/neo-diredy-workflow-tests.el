;;; neo-diredy-workflow-tests.el --- Bookmarks, preview and cleanup -*- lexical-binding: t; -*-
(unless (boundp 'neo-diredy-test-root)
  (load (expand-file-name "neo-diredy-tests.el" (file-name-directory load-file-name)) nil t))
(require 'bookmark)

(defmacro neo-diredy-workflow--with-bookmarks (&rest body)
  `(neo-diredy-test--with-directory
    (let ((bookmark-default-file (expand-file-name "bookmarks" root))
          (bookmark-alist nil) (bookmark-alist-modification-count 0)
          (bookmark-bookmarks-timestamp nil) (bookmark-watch-bookmark-file nil)
          (bookmark-save-flag 1) (make-backup-files nil) (create-lockfiles nil))
      ,@body)))

(ert-deftest neo-diredy-workflow-bookmark-save-reload-and-delete ()
  (neo-diredy-workflow--with-bookmarks
   (neo-diredy-bookmark-add "Work 日本語")
   (should (equal (bookmark-get-filename "Work 日本語") (file-name-as-directory root)))
   (should (file-exists-p bookmark-default-file))
   (setq bookmark-alist nil bookmark-bookmarks-timestamp nil)
   (bookmark-maybe-load-default-file)
   (should (= (length (neo-diredy--bookmark-choices)) 1))
   (cl-letf (((symbol-function 'neo-diredy--read-choice) (lambda (_ choices) (car choices))))
     (neo-diredy-bookmark-delete))
   (setq bookmark-alist nil bookmark-bookmarks-timestamp nil)
   (bookmark-maybe-load-default-file)
   (should-not (neo-diredy--bookmark-choices))))

(ert-deftest neo-diredy-workflow-bookmark-preserves-unrelated-records ()
  (neo-diredy-workflow--with-bookmarks
   (bookmark-store "Existing" `((filename . ,file)) nil)
   (let ((before (copy-tree bookmark-alist)))
     (should-error (neo-diredy-bookmark-add "Existing") :type 'user-error)
     (should (equal bookmark-alist before)))
   (should-error (neo-diredy-bookmark-add "  ") :type 'user-error)
   (neo-diredy-bookmark-add "Directory")
   (should-error (neo-diredy-bookmark-add "Directory") :type 'user-error)
   (should (equal (mapcar #'cdr (neo-diredy--bookmark-choices)) '("Directory")))
   (let ((before (copy-tree bookmark-alist)))
     (cl-letf (((symbol-function 'neo-diredy--read-choice) (lambda (&rest _) nil)))
       (neo-diredy-bookmark-delete)
       (neo-diredy-bookmark-jump))
     (should (equal bookmark-alist before)))
   (let ((default-directory "/ssh:host:/directory/"))
     (should-error (neo-diredy-bookmark-add "Remote") :type 'user-error))))

(ert-deftest neo-diredy-workflow-bookmark-jump-keeps-layout ()
  (neo-diredy-workflow--with-bookmarks
   (bookmark-store "Child" `((filename . ,child) (neo-diredy . t)) nil)
   (neo-diredy--layout-mode 1)
   (cl-letf (((symbol-function 'neo-diredy--read-choice)
              (lambda (title choices) (should (equal title "Bookmarks")) (car choices))))
     (neo-diredy-bookmark-jump))
   (neo-diredy--post-command)
   (should (equal default-directory (file-name-as-directory child)))
   (should (neo-diredy--layout-intact-p))
   (bookmark-delete "Child")
   (bookmark-store "Missing" `((filename . ,(expand-file-name "missing" root)) (neo-diredy . t)) nil)
   (cl-letf (((symbol-function 'neo-diredy--read-choice) (lambda (_ choices) (car choices))))
     (should-error (neo-diredy-bookmark-jump) :type 'user-error))
   (should (equal default-directory (file-name-as-directory child)))))

(ert-deftest neo-diredy-workflow-preview-scroll-keeps-selection ()
  (neo-diredy-test--with-directory
   (with-temp-file file (dotimes (i 200) (insert (format "Line %03d\n" i))))
   (neo-diredy--layout-mode 1)
   (dired-goto-file file)
   (neo-diredy--refresh)
   (let ((point (point)) (window (selected-window)))
     (neo-diredy-preview-scroll-up 5)
     (should (> (window-start neo-diredy--right) 1))
     (neo-diredy--post-command)
     (neo-diredy--refresh)
     (should (> (window-start neo-diredy--right) 1))
     (neo-diredy-preview-scroll-down 5)
     (should (= (window-start neo-diredy--right) 1))
     (should (eq window (selected-window)))
     (should (= (point) point))
     (should (equal (dired-get-filename) file)))))

(ert-deftest neo-diredy-workflow-preview-expand-and-return ()
  (neo-diredy-test--with-directory
   (let ((source (current-buffer)) (neo-diredy-preview-bytes 16) viewer)
     (with-temp-file file (insert "first line\nsecond line\nthird line\n"))
     (neo-diredy--layout-mode 1)
     (dired-goto-file file)
     (neo-diredy--refresh)
     (let ((text (with-current-buffer neo-diredy--preview (buffer-string)))
           (panes (list neo-diredy--parent neo-diredy--preview neo-diredy--details-buffer)))
       (neo-diredy-preview-expand)
       (setq viewer (current-buffer))
       (should (derived-mode-p 'neo-diredy-preview-mode))
       (should buffer-read-only)
       (should-not buffer-file-name)
       (should (equal (buffer-string) text))
       (should (string-match-p "preview truncated" text))
       (should (= (length (window-list)) 1))
       (should-not (cl-some #'buffer-live-p panes))
       (neo-diredy-preview-close)
       (should-not (buffer-live-p viewer))
       (should (eq (current-buffer) source))
       (should (equal (dired-get-filename) file))
       (should (neo-diredy--layout-intact-p))))))

(ert-deftest neo-diredy-workflow-preview-resize-retains-scroll ()
  (neo-diredy-test--with-directory
   (with-temp-file file (dotimes (i 200) (insert (format "Line %03d\n" i))))
   (neo-diredy--layout-mode 1)
   (dired-goto-file file)
   (neo-diredy--refresh)
   (neo-diredy-preview-scroll-up 5)
   (let ((start (window-start neo-diredy--right)))
     (window-resize neo-diredy--right -1 t)
     (neo-diredy--refresh)
     (should (= (window-start neo-diredy--right) start)))
   (dired-goto-file child)
   (neo-diredy--refresh)
   (should (= (window-start neo-diredy--right) 1))))

(ert-deftest neo-diredy-workflow-preview-copies-image-size ()
  (neo-diredy-test--with-directory
   (neo-diredy--layout-mode 1)
   (dired-goto-file file)
   (neo-diredy--refresh)
   (let ((image '(image :type png :data "test" :max-width 10 :max-height 10)))
     (with-current-buffer neo-diredy--preview
       (let ((inhibit-read-only t)) (erase-buffer) (insert (propertize "x" 'display image))))
     (neo-diredy-preview-expand)
     (should (> (image-property (get-text-property 1 'display) :max-width) 10))
     (should (= (image-property image :max-width) 10))
     (neo-diredy-preview-close))))

(ert-deftest neo-diredy-workflow-cleanup-removes-unused-visited-dired ()
  (neo-diredy-test--with-directory
   (let ((source (current-buffer)) visited)
     (neo-diredy--layout-mode 1)
     (dired child)
     (neo-diredy--post-command)
     (setq visited (current-buffer))
     (dired root)
     (neo-diredy--post-command)
     (neo-diredy--layout-mode -1)
     (should (buffer-live-p source))
     (should-not (buffer-live-p visited)))))

(ert-deftest neo-diredy-workflow-cleanup-protects-user-state ()
  (dolist (kind '(existing marked modified wdired visible))
    (neo-diredy-test--with-directory
     (let ((nested (expand-file-name "nested.txt" child)) visited)
       (with-temp-file nested (insert "example"))
       (when (eq kind 'existing) (dired-noselect child))
       (neo-diredy--layout-mode 1)
       (dired child)
       (neo-diredy--post-command)
       (setq visited (current-buffer))
       (dired-goto-file nested)
       (pcase kind
         ('marked (dired-mark 1))
         ('modified (set-buffer-modified-p t))
         ('wdired (wdired-change-to-wdired-mode)))
       (unless (eq kind 'visible)
         (dired root)
         (neo-diredy--post-command))
       (neo-diredy--layout-mode -1)
       (should (buffer-live-p visited))))))

(ert-deftest neo-diredy-workflow-cleanup-keeps-file-return-directory ()
  (neo-diredy-test--with-directory
   (let ((nested (expand-file-name "nested.txt" child)) visited)
     (with-temp-file nested (insert "example"))
     (neo-diredy--layout-mode 1)
     (dired child)
     (neo-diredy--post-command)
     (setq visited (current-buffer))
     (dired-goto-file nested)
     (dired-find-file)
     (neo-diredy--post-command)
     (should-not neo-diredy--layout-mode)
     (should (buffer-live-p visited))
     (switch-to-prev-buffer)
     (should (eq (current-buffer) visited))
     (should (equal (dired-get-filename) nested)))))

(ert-deftest neo-diredy-workflow-preview-close-respects-mode-disable ()
  (neo-diredy-test--with-directory
   (unwind-protect
       (progn
         (neo-diredy-mode 1)
         (dired-goto-file file)
         (neo-diredy-preview-expand)
         (neo-diredy-mode -1)
         (neo-diredy-preview-close)
         (should (derived-mode-p 'dired-mode))
         (should-not neo-diredy--layout-mode))
     (neo-diredy-mode -1))))

(ert-deftest neo-diredy-workflow-cleanup-protects-saved-tab ()
  (neo-diredy-test--with-directory
   (let ((tabs (frame-parameter nil 'tabs)) visited saved)
     (unwind-protect
         (progn
           (neo-diredy--layout-mode 1)
           (dired child)
           (neo-diredy--post-command)
           (setq visited (current-buffer)
                 saved (window-state-get (frame-root-window) t))
           (dired root)
           (neo-diredy--post-command)
           (set-frame-parameter nil 'tabs
                                (list (car (tab-bar-tabs)) `(tab (name . "Saved") (ws . ,saved))))
           (should (tab-bar-get-buffer-tab visited t))
           (neo-diredy--layout-mode -1)
           (should (buffer-live-p visited)))
       (set-frame-parameter nil 'tabs tabs)))))

(ert-deftest neo-diredy-workflow-keys-restore-on-disable ()
  (neo-diredy-test--with-directory
   (let* ((bindings '(("C-c b a" . neo-diredy-bookmark-add)
                      ("C-c b j" . neo-diredy-bookmark-jump)
                      ("C-c b d" . neo-diredy-bookmark-delete)
                      ("M-<down>" . neo-diredy-preview-scroll-up)
                      ("M-<up>" . neo-diredy-preview-scroll-down)
                      ("C-c p" . neo-diredy-preview-expand)))
          (before (mapcar (lambda (entry) (key-binding (kbd (car entry)))) bindings)))
     (neo-diredy--layout-mode 1)
     (dolist (entry bindings) (should (eq (key-binding (kbd (car entry))) (cdr entry))))
     (neo-diredy--layout-mode -1)
     (should (equal before (mapcar (lambda (entry) (key-binding (kbd (car entry)))) bindings))))))

(ert-deftest neo-diredy-workflow-preview-rejects-inactive-and-editing ()
  (should-error (neo-diredy-preview-expand) :type 'user-error)
  (should-error (neo-diredy-preview-scroll-up) :type 'user-error)
  (neo-diredy-test--with-directory
   (neo-diredy--layout-mode 1)
   (dired-goto-file file)
   (wdired-change-to-wdired-mode)
   (unwind-protect
       (progn (should-error (neo-diredy-preview-expand) :type 'user-error)
              (should (derived-mode-p 'wdired-mode)))
     (wdired-abort-changes))))

(ert-deftest neo-diredy-workflow-gui-real-key-round-trip ()
  (skip-unless (display-graphic-p))
  (neo-diredy-workflow--with-bookmarks
   (bookmark-store "Child" `((filename . ,child) (neo-diredy . t)) nil)
   (with-temp-file (expand-file-name "long.txt" child)
     (dotimes (i 300) (insert (format "Line %03d\n" i))))
   (neo-diredy--layout-mode 1)
   (let ((frames (frame-list)))
     (execute-kbd-macro (kbd "C-c b j RET"))
     (should (equal default-directory (file-name-as-directory child)))
     (should-not (cl-set-difference (frame-list) frames))
     (let ((position (point)) (window (selected-window)) viewer)
       (execute-kbd-macro (kbd "M-<down>"))
       (redisplay t)
       (should (> (window-start neo-diredy--right) 1))
       (should (= (point) position))
       (should (eq (selected-window) window))
       (execute-kbd-macro (kbd "C-c p"))
       (setq viewer (current-buffer))
       (should (derived-mode-p 'neo-diredy-preview-mode))
       (execute-kbd-macro (kbd "q"))
       (should-not (buffer-live-p viewer))
       (should (neo-diredy--layout-intact-p))
       (should (= (point) position)))
     (execute-kbd-macro (kbd "C-c b d <escape>"))
     (should (bookmark-get-bookmark "Child" t))
     (should-not (cl-set-difference (frame-list) frames)))))

(ert-deftest neo-diredy-workflow-gui-image-expands-to-window ()
  (skip-unless (and (display-graphic-p) (image-type-available-p 'pbm)))
  (neo-diredy-test--with-directory
   (let ((path (expand-file-name "image.ppm" root)) small-width)
     (with-temp-buffer
       (set-buffer-multibyte nil)
       (insert "P6\n1200 800\n255\n" (make-string (* 1200 800 3) 127))
       (let ((coding-system-for-write 'no-conversion)) (write-region (point-min) (point-max) path nil 'silent)))
     (revert-buffer nil t)
     (neo-diredy--layout-mode 1)
     (dired-goto-file path)
     (neo-diredy--refresh)
     (setq small-width (car (image-size (with-current-buffer neo-diredy--preview
                                        (get-text-property 1 'display)) t)))
     (neo-diredy-preview-expand)
     (redisplay t)
     (should (> (car (image-size (get-text-property 1 'display) t)) small-width))
     (neo-diredy-preview-close)
     (should (equal (dired-get-filename) path)))))
