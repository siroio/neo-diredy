;;; neo-diredy-navigation-tests.el --- Selection and viewport checks -*- lexical-binding: t; -*-
(unless (boundp 'neo-diredy-test-root)
  (load (expand-file-name "neo-diredy-tests.el" (file-name-directory load-file-name)) nil t))

(ert-deftest neo-diredy-navigation-skips-non-file-rows ()
  (neo-diredy-test--with-directory
   (neo-diredy--layout-mode 1)
   (dolist (boundary (list (point-min) (point-max)))
     (goto-char boundary)
     (neo-diredy--post-command)
     (should (member (dired-get-filename nil t) (list child file)))
     (should-not (invisible-p (point))))
   (dotimes (_ 4)
     (dired-next-line 1)
     (neo-diredy--post-command)
     (should (equal (dired-get-filename nil t) file)))
   (dotimes (_ 8)
     (dired-previous-line 1)
     (neo-diredy--post-command)
     (should (member (dired-get-filename nil t) (list child file))))))

(ert-deftest neo-diredy-navigation-empty-directory-has-no-selection ()
  (neo-diredy-test--with-directory
   (neo-diredy--layout-mode 1)
   (dired-goto-file child)
   (dired-find-file)
   (neo-diredy--post-command)
   (goto-char (point-max))
   (neo-diredy--post-command)
   (hl-line-highlight)
   (should-not (neo-diredy--original-file))
   (should (or (not (overlay-buffer hl-line-overlay))
               (= (overlay-start hl-line-overlay) (overlay-end hl-line-overlay))))))

(ert-deftest neo-diredy-navigation-long-directory-round-trip ()
  (skip-unless (display-graphic-p))
  (neo-diredy-test--with-directory
   (let ((scroll-margin 4) (scroll-conservatively 101)
         (target (expand-file-name "dir-120" root)))
     (dotimes (i 150)
       (make-directory (expand-file-name (format "dir-%03d" i) root)))
     (with-temp-file (expand-file-name "nested.txt" target) (insert "hello"))
     (revert-buffer nil t)
     (neo-diredy--layout-mode 1)
     (dired-goto-file target)
     (neo-diredy--post-command)
     (recenter 10)
     (redisplay t)
     (let ((start (window-start neo-diredy--center)))
       (dotimes (_ 3)
         (dired-find-file)
         (neo-diredy--post-command)
         (redisplay t)
         (dired-up-directory)
         (neo-diredy--post-command)
         (should (= (window-start neo-diredy--center) start))
         (redisplay t)
         (should (equal (dired-get-filename nil t) target))
         (should (= (window-start neo-diredy--center) start))
         (should (pos-visible-in-window-p (point) neo-diredy--center))
         (should (zerop (window-hscroll neo-diredy--center))))))))

(ert-deftest neo-diredy-navigation-folded-subdir-stays-operable ()
  (neo-diredy-test--with-directory
   (with-temp-file (expand-file-name "nested.txt" child) (insert "hello"))
   (neo-diredy--layout-mode 1)
   (dired-goto-file child)
   (dired-maybe-insert-subdir child)
   (neo-diredy--post-command)
   (dired-goto-file (expand-file-name "nested.txt" child))
   (dired-hide-subdir 1)
   (neo-diredy--post-command)
   (should (equal (dired-get-filename nil t) child))
   (should (dired-subdir-hidden-p (file-name-as-directory child)))
   (dired-hide-subdir 1)
   (neo-diredy--post-command)
   (should (equal (dired-get-filename nil t) child))
   (should-not (dired-subdir-hidden-p (file-name-as-directory child)))
   (dired-kill-subdir)
   (neo-diredy--post-command)
   (should (equal (dired-get-filename nil t) child))
   (should-not (assoc (file-name-as-directory child) dired-subdir-alist))
   (neo-diredy--layout-mode -1)
   (should-not (advice-member-p #'neo-diredy--subdir-command 'dired-hide-subdir))
   (should-not (advice-member-p #'neo-diredy--subdir-hidden-p 'dired-subdir-hidden-p))))
