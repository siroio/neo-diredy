;;; neo-diredy-metadata-tests.el --- Metadata checks -*- lexical-binding: t; -*-
(unless (boundp 'neo-diredy-test-root)
  (load (expand-file-name "neo-diredy-tests.el" (file-name-directory load-file-name)) nil t))

(defun neo-diredy-test--wait-metadata ()
  (let ((deadline (+ (float-time) 15)))
    (while (and neo-diredy--metadata-jobs (< (float-time) deadline))
      (accept-process-output nil 0.05))
    (should-not neo-diredy--metadata-jobs)))

(ert-deftest neo-diredy-metadata-modeline-fits-and-prioritizes-state ()
  (neo-diredy-test--with-directory
   (dired-goto-file file)
   (neo-diredy--layout-mode 1)
   (let* ((neo-diredy-git-status t)
          (neo-diredy--git-location default-directory)
          (states (make-hash-table :test #'equal))
          (neo-diredy--git-state (cons (concat "feature/" (make-string 120 ?x)) states)))
     (puthash file " M" states)
     (dired-mark 1)
     (dired-goto-file file)
     (dolist (width '(28 32 64))
       (cl-letf (((symbol-function 'window-total-width) (lambda (&rest _) width)))
         (let ((line (neo-diredy--status)))
           (should (<= (string-width line) width))
           (should (string-match-p "Git \\[ M\\]" line))
           (should (string-match-p (regexp-quote (neo-diredy--size-label file)) line))
           (should (string-match-p "1 marked\\|\\*1" line))
           (should-not (string-match-p "hello.txt\\|M-x" line))))))))

(ert-deftest neo-diredy-metadata-git-acquisition-visible ()
  (neo-diredy-test--with-directory
   (dired-goto-file file)
   (neo-diredy--layout-mode 1)
   (let ((neo-diredy-git-status t) (neo-diredy--git-location nil)
         callback)
     (cl-letf (((symbol-function 'executable-find) (lambda (_) nil)))
       (neo-diredy--metadata-refresh file)
       (should (string-match-p "Git missing" (neo-diredy--status))))
     (setq neo-diredy--git-location nil)
     (cl-letf (((symbol-function 'executable-find) (lambda (_) "git"))
               ((symbol-function 'neo-diredy--metadata-start)
                (lambda (_kind _key _command next) (setq callback next))))
       (neo-diredy--metadata-refresh file)
       (should (string-match-p "Git loading" (neo-diredy--status)))
       (funcall callback nil)
       (should (string-match-p "Git unavailable" (neo-diredy--status)))
       (setq neo-diredy--git-location nil)
       (neo-diredy--metadata-refresh file)
       (funcall callback root)
       (funcall callback nil)
       (should (string-match-p "Git error" (neo-diredy--status)))))))

(ert-deftest neo-diredy-metadata-git-parser ()
  (let* ((root (expand-file-name "fixture" neo-diredy-test-root))
         (result (neo-diredy--git-parse
                  root (concat "## main...origin/main [ahead 1]\0"
                               " M src/a file\0M  src/日本語\0"
                               "R  new name\0source/old name\0"
                               "?? fresh/\0UU conflict/file\0 D gone/file\0"
                               "AA clash/a\0 M clash/b\0"
                               "A  pair/staged\0 A pair/intent\0")))
         (states (cdr result)))
    (should (equal (car result) "main...origin/main [ahead 1]"))
    (should (equal (gethash (expand-file-name "src" root) states) "MM"))
    (should (equal (gethash (expand-file-name "new name" root) states) "R "))
    (should-not (gethash (expand-file-name "old name" root) states))
    (should (equal (gethash (expand-file-name "source" root) states) "R "))
    (should (equal (gethash (expand-file-name "fresh" root) states) "??"))
    (should (equal (gethash (expand-file-name "conflict" root) states) "UU"))
    (should (equal (gethash (expand-file-name "clash" root) states) "AA"))
    (should (equal (gethash (expand-file-name "pair" root) states) "**"))
    (let ((neo-diredy--git-state result))
      (should (equal (neo-diredy--git-label (expand-file-name "fresh/nested/file" root)) "??")))
    (should (equal (gethash (expand-file-name "gone" root) states) " D"))))

(ert-deftest neo-diredy-metadata-sizes-and-editable-name ()
  (neo-diredy-test--with-directory
   (let ((long (expand-file-name (concat (make-string 100 ?x) ".txt") root)))
     (with-temp-file long (insert (make-string 2048 ?a)))
     (revert-buffer)
     (neo-diredy--layout-mode 1)
     (dired-goto-file long)
     (should (equal (neo-diredy--size-label long) "2 KiB"))
     (should (equal (neo-diredy--size-label child) "—"))
     (should (string-match-p "2 KiB" (neo-diredy--status)))
     (let* ((row (cl-find long neo-diredy--overlays :test #'equal
                          :key (lambda (overlay) (overlay-get overlay 'neo-diredy-file))))
            (display (get-text-property 0 'display (overlay-get row 'before-string))))
       (should (equal (car display) '(margin right-margin)))
       (should (string-match-p "2 KiB" (cadr display))))
     (let ((text (buffer-string)))
       (neo-diredy--metadata-paint)
       (should (equal text (buffer-string))))
     (wdired-change-to-wdired-mode)
     (neo-diredy--post-command)
     (insert "new-")
     (neo-diredy--metadata-paint)
     (wdired-finish-edit)
     (neo-diredy--post-command)
     (should (file-exists-p (expand-file-name (concat "new-" (file-name-nondirectory long)) root))))))

(ert-deftest neo-diredy-metadata-directory-async-cache-refresh ()
  (neo-diredy-test--with-directory
   (let ((neo-diredy-directory-sizes t))
     (with-temp-file (expand-file-name ".hidden" child) (insert (make-string 1024 ?x)))
     (make-directory (expand-file-name "nested" child))
     (with-temp-file (expand-file-name "nested/file" child) (insert (make-string 1024 ?x)))
     (neo-diredy--layout-mode 1)
     (dired-goto-file child)
     (neo-diredy--refresh)
     (should (assq 'size neo-diredy--metadata-jobs))
     (neo-diredy-test--wait-metadata)
     (should (equal (neo-diredy--size-label child) "2 KiB"))
     (should (string-match-p "2 KiB" (with-current-buffer neo-diredy--details-buffer (buffer-string))))
     (neo-diredy--refresh)
     (should-not (assq 'size neo-diredy--metadata-jobs))
     (with-temp-file (expand-file-name "extra" child) (insert (make-string 1024 ?x)))
     (revert-buffer)
     (neo-diredy--refresh)
     (neo-diredy-test--wait-metadata)
     (should (equal (neo-diredy--size-label child) "3 KiB")))))

(ert-deftest neo-diredy-metadata-real-git ()
  (skip-unless (executable-find "git"))
  (neo-diredy-test--with-directory
   (let ((neo-diredy-git-status t)
         (process-environment (copy-sequence process-environment)))
     ;; Isolate fixture Git configuration, hooks, signing and identity.
     (setenv "GIT_CONFIG_GLOBAL" "NUL")
     (setenv "GIT_CONFIG_NOSYSTEM" "1")
     (with-temp-file (expand-file-name "child/existing.txt" root) (insert "tracked"))
     (dolist (args '(("init" "--initial-branch=main") ("add" "hello.txt" "child/existing.txt")
                     ("-c" "user.name=Fixture" "-c" "user.email=fixture@example.invalid"
                      "-c" "commit.gpgsign=false" "commit" "-m" "fixture")))
       (should (zerop (apply #'call-process "git" nil nil nil args))))
     (with-temp-file file (insert "modified"))
     (with-temp-file (expand-file-name "child/new.txt" root) (insert "new"))
     (dired-goto-file file)
     (neo-diredy--layout-mode 1)
     (neo-diredy-test--wait-metadata)
     (should (equal (neo-diredy--git-label file) " M"))
     (should (equal (neo-diredy--git-label child) "??"))
     (should (equal (neo-diredy--git-label (expand-file-name "child/existing.txt" root)) "  "))
     (should (string-match-p "main" (neo-diredy--status)))
     (when (display-graphic-p)
       (redisplay t)
       (let* ((position (posn-at-point (point) neo-diredy--center))
              (y (+ (window-header-line-height neo-diredy--center) 4 (cdr (posn-x-y position))))
              (line (format-mode-line mode-line-format nil neo-diredy--center (current-buffer)))
              visible)
         ;; Inspect rendered glyphs, not just the overlay's display property.
         (dotimes (x (window-pixel-width neo-diredy--center))
           (let ((pos (posn-at-x-y x y neo-diredy--center t)))
             (when (eq (posn-area pos) 'right-margin)
               (push (car (posn-string pos)) visible))))
         (should (cl-some (lambda (text) (and text (string-match-p " M" text))) visible))
         (should (<= (string-width line) (window-total-width neo-diredy--center)))
         (should (string-match-p "Git \\[ M\\] main" line))))
     ;; The asynchronous result must reach the preview without another move.
     (let ((footer (with-current-buffer neo-diredy--details-buffer (buffer-string))))
       (should (string-match-p "Git \\[ M\\]" footer))
       (should (string-match-p "main" footer)))
     (should (zerop (call-process "git" nil nil nil "add" "hello.txt")))
     (revert-buffer)
     (neo-diredy--refresh)
     (neo-diredy-test--wait-metadata)
     (should (equal (neo-diredy--git-label file) "M "))
     (should (string-match-p "Git \\[M \\]" (with-current-buffer neo-diredy--details-buffer (buffer-string)))))))

(ert-deftest neo-diredy-metadata-cancel-on-selection-and-close ()
  (neo-diredy-test--with-directory
   (neo-diredy--layout-mode 1)
   (let (called)
     (neo-diredy--metadata-start
      'size child (list (expand-file-name invocation-name invocation-directory)
                       "-Q" "--batch" "--eval" "(sleep-for 5)")
      (lambda (_) (setq called t)))
     (let* ((process (cdr (assq 'size neo-diredy--metadata-jobs)))
            (buffer (process-buffer process)))
       (dired-goto-file file)
       (neo-diredy--post-command)
       (should-not (process-live-p process))
       (should-not (buffer-live-p buffer))
       (should-not called)
       (should-not neo-diredy--metadata-jobs)))
   (neo-diredy--layout-mode -1)
   (should-not (cdr (window-margins)))
   (should-not neo-diredy--size-cache)))

(ert-deftest neo-diredy-metadata-timeout-and-start-error ()
  (neo-diredy-test--with-directory
   (neo-diredy--layout-mode 1)
   (let ((timer-function (symbol-function 'run-at-time)) (result 'waiting))
     (cl-letf (((symbol-function 'run-at-time)
                (lambda (_time repeat function &rest args)
                  (apply timer-function 0.01 repeat function args))))
       (neo-diredy--metadata-start
        'size child (list (expand-file-name invocation-name invocation-directory)
                         "-Q" "--batch" "--eval" "(sleep-for 5)")
        (lambda (output) (setq result output))))
     (neo-diredy-test--wait-metadata)
     (should-not result)
     (setq result 'waiting)
     (neo-diredy--metadata-start 'size child '("nonexistent-neo-diredy-program")
                                  (lambda (output) (setq result output)))
     (should-not result)
     (should-not neo-diredy--metadata-jobs))))

(ert-deftest neo-diredy-metadata-git-absent-and-nonrepo ()
  (neo-diredy-test--with-directory
   (let ((neo-diredy-git-status t))
     (cl-letf (((symbol-function 'executable-find) (lambda (_) nil)))
       (neo-diredy--layout-mode 1)
       (should-not neo-diredy--metadata-jobs)
       (should-not neo-diredy--git-state))
     (let ((process-environment (copy-sequence process-environment)))
       (setenv "GIT_CEILING_DIRECTORIES" (directory-file-name neo-diredy-test-root))
       (neo-diredy--metadata-stop)
       (neo-diredy--refresh)
       (neo-diredy-test--wait-metadata)
       (should-not neo-diredy--git-state)))))

(ert-deftest neo-diredy-metadata-unreadable-does-not-report-partial-total ()
  (cl-letf (((symbol-function 'directory-files-and-attributes)
             (lambda (&rest _) (signal 'file-error '("Permission denied")))))
    (should-error (neo-diredy--directory-total "unreadable") :type 'file-error))
  (neo-diredy-test--with-directory
   (neo-diredy--layout-mode 1)
   (let ((neo-diredy-directory-sizes t))
     (delete-directory child)
     (dired-goto-file child)
     (neo-diredy--metadata-refresh child)
     (neo-diredy-test--wait-metadata)
     (should (equal (neo-diredy--size-label child) "!")))))

(ert-deftest neo-diredy-metadata-narrow-pane-restores-margin ()
  (neo-diredy-test--with-directory
   (set-window-margins nil 1 2)
   (neo-diredy--layout-mode 1)
   (let ((width-function (symbol-function 'window-total-width)))
     (cl-letf (((symbol-function 'window-total-width)
                (lambda (&optional window _round) (if (eq window neo-diredy--center) 31
                                                 (funcall width-function window)))))
       (neo-diredy--style)
       (should-not (cdr (window-margins neo-diredy--center)))))
   (neo-diredy--style)
   (neo-diredy--layout-mode -1)
   (should (equal (window-margins) '(1 . 2)))
   (set-window-margins nil 3 4)
   (neo-diredy-mode -1)
   (should (equal (window-margins) '(3 . 4)))))

(ert-deftest neo-diredy-metadata-directory-skips-links ()
  (neo-diredy-test--with-directory
   (with-temp-file (expand-file-name "nested" child) (insert "excluded"))
   ;; Also covers a selected directory replaced by a link before the worker starts.
   (cl-letf (((symbol-function 'file-symlink-p)
              (lambda (name) (equal (directory-file-name name) child))))
     (should (= (neo-diredy--directory-total child) 0))
     (should (= (neo-diredy--directory-total root)
                (file-attribute-size (file-attributes file)))))))

(ert-deftest neo-diredy-metadata-output-is-bounded ()
  (neo-diredy-test--with-directory
   (neo-diredy--layout-mode 1)
   (let ((result 'waiting))
     (neo-diredy--metadata-start
      'size child (list (expand-file-name invocation-name invocation-directory)
                       "-Q" "--batch" "--eval" "(princ (make-string (* 9 1024 1024) 120))")
      (lambda (output) (setq result output)))
     (neo-diredy-test--wait-metadata)
     (should-not result))))
