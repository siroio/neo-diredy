;;; check-dired-yazi.el --- Isolated layout checks -*- lexical-binding: t; -*-
;; Run: emacs -Q --batch -l check-dired-yazi.el
(require 'ert)
(require 'dired)
(require 'wdired)
(add-to-list 'load-path (expand-file-name ".." (file-name-directory load-file-name)))
(require 'neo-diredy nil t)
(defconst neo-diredy-test-root (file-name-directory load-file-name))

(when (fboundp 'neo-diredy-mode) (neo-diredy-mode -1))

(defmacro neo-diredy-test--with-directory (&rest body)
  `(let* ((temporary-file-directory neo-diredy-test-root)
          (neo-diredy-git-status nil)
          (neo-diredy-directory-sizes nil)
          (root (make-temp-file "yazi-test-" t))
          (child (expand-file-name "child" root))
          (file (expand-file-name "hello.txt" root))
          (original (current-window-configuration)))
     (unwind-protect
         (progn
           (make-directory child)
           (with-temp-file file (insert "hello preview\n"))
           (delete-other-windows)
           (dired root)
           ,@body)
       (when (bound-and-true-p neo-diredy--layout-mode) (neo-diredy--layout-mode -1))
       (set-window-configuration original)
       (dolist (buffer (buffer-list))
         (when (with-current-buffer buffer
                 (string-prefix-p (file-name-as-directory root) default-directory))
           (with-current-buffer buffer (set-buffer-modified-p nil))
           (kill-buffer buffer)))
       (delete-directory root t))))

(ert-deftest neo-diredy-icon-selection-follows-row ()
  (neo-diredy-test--with-directory
   (neo-diredy--layout-mode 1)
   (cl-labels
       ((check-icons (selected)
          (dolist (overlay neo-diredy--overlays)
            (when-let* ((path (overlay-get overlay 'neo-diredy-file)))
              (let* ((text (overlay-get overlay 'before-string))
                     (start (- (length text) 2)))
                ;; Both the glyph and its trailing space must match the row.
                (dolist (index (list start (1+ start)))
                  (let ((face (get-text-property index 'face text)))
                    (should (eq (and (listp face) (memq 'neo-diredy-selection face) t)
                                (equal path selected))))))))))
     (dolist (selected (list child file child))
       (dired-goto-file selected)
       (neo-diredy--post-command)
       (check-icons selected)
       (neo-diredy--metadata-paint)
       (check-icons selected))
     (revert-buffer nil t)
     (neo-diredy--post-command)
     (check-icons (dired-get-filename))
     (dired-goto-file file)
     (wdired-change-to-wdired-mode)
     (neo-diredy--post-command)
     (insert "renamed-")
     (neo-diredy--post-command)
     (check-icons file)
     (wdired-abort-changes))))

(ert-deftest neo-diredy-tab-clones-current-directory ()
  (neo-diredy-test--with-directory
   (let ((dired-kill-when-opening-new-dired-buffer nil))
     (neo-diredy--layout-mode 1)
     (dired-goto-file child)
     (dired-find-file)
     (neo-diredy--post-command)
     (unwind-protect
         (progn
           (tab-new)
           (should (equal (file-name-as-directory child) default-directory)))
       (tab-close)))))

(ert-deftest neo-diredy-wdired-headers-follow-edit-session ()
  (dolist (finish '(wdired-finish-edit wdired-abort-changes))
    (neo-diredy-test--with-directory
     (neo-diredy--layout-mode 1)
     (dired-goto-file file)
     (wdired-change-to-wdired-mode)
     (neo-diredy--post-command)
     (should (string-match-p "名前変更中" (eval (cadr header-line-format) t)))
     (with-current-buffer neo-diredy--parent
       (let ((text (eval (cadr header-line-format) t)))
         (should (string-match-p "C-c C-c" text))
         (should (<= (string-width text) (window-body-width neo-diredy--left)))))
     (should (string-match-p "C-c C-k" (neo-diredy--preview-header)))
     (funcall finish)
     (neo-diredy--post-command)
     (should-not (string-match-p "名前変更中" (eval (cadr header-line-format) t)))
     (with-current-buffer neo-diredy--parent
       (should (equal (eval (cadr header-line-format) t) "  Parent")))
     (should-not (string-match-p "C-c C-k" (neo-diredy--preview-header))))))

(ert-deftest neo-diredy-wdired-edit-keeps-layout ()
  (neo-diredy-test--with-directory
   (neo-diredy--layout-mode 1)
   (dired-goto-file file)
   (dired-toggle-read-only)
   (neo-diredy--post-command)
   (should (eq major-mode 'wdired-mode))
   (should neo-diredy--layout-mode)
   (should (= (+ 4 (if (window-live-p neo-diredy--details-window) 1 0)) (length (window-list))))
   (should dired-hide-details-mode)
   (should cursor-type)
   (insert "renamed-")
   (neo-diredy--post-command)
   (should neo-diredy--layout-mode)
   (wdired-finish-edit)
   (neo-diredy--post-command)
   (should (file-exists-p (expand-file-name "renamed-hello.txt" root)))
   (should-not (file-exists-p file))
   (should neo-diredy--layout-mode)
   (should dired-hide-details-mode)))

