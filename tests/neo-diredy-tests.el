(ert-deftest neo-diredy-list-operations-keep-style ()
  (neo-diredy-test--with-directory
   (with-temp-file (expand-file-name "nested.txt" child) (insert "nested"))
   (neo-diredy--layout-mode 1)
   ;; Exercise commands that rewrite the listing or its text properties.
   (dolist (operation
            (list (lambda () (dired-goto-file file) (dired-mark 1))
                  (lambda () (dired-goto-file file) (dired-unmark 1))
                  (lambda () (dired-goto-file file) (dired-flag-file-deletion 1))
                  (lambda () (dired-goto-file file) (dired-unmark 1))
                  (lambda () (dired-sort-toggle-or-edit))
                  (lambda () (revert-buffer))
                  (lambda () (dired-goto-file file) (dired-do-redisplay))
                  (lambda () (dired-goto-file child) (dired-maybe-insert-subdir child))
                  (lambda () (dired-goto-file (expand-file-name "nested.txt" child)) (dired-hide-subdir 1))
                  (lambda () (dired-hide-subdir 1))
                  (lambda () (dired-kill-subdir))))
     (funcall operation)
     (neo-diredy--post-command)
     (should neo-diredy--layout-mode)
     (should dired-hide-details-mode)
     (should (= (+ 4 (if (window-live-p neo-diredy--details-window) 1 0)) (length (window-list))))
     (should (cl-every (lambda (overlay) (eq (overlay-buffer overlay) (current-buffer)))
                       neo-diredy--overlays)))))

(ert-deftest neo-diredy-presentation-only-command-keeps-style ()
  (neo-diredy-test--with-directory
   (neo-diredy--layout-mode 1)
