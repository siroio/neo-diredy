   (neo-diredy--post-command)
   (let ((tick (buffer-chars-modified-tick)) (position (point))
         (overlays (copy-sequence neo-diredy--overlays)))
     (dired-hide-details-mode -1)
     (neo-diredy--post-command)
     (should (= tick (buffer-chars-modified-tick)))
     (should (= position (point)))
     (should (equal overlays neo-diredy--overlays))
     (should dired-hide-details-mode))))

(ert-deftest neo-diredy-file-operations-keep-style ()
  (neo-diredy-test--with-directory
   (neo-diredy--layout-mode 1)
   (let ((copy (expand-file-name "copy.txt" root))
         (renamed (expand-file-name "renamed.txt" root))
         (created (expand-file-name "created" root)))
     (dired-goto-file file)
     (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) copy)))
       (dired-do-copy))
     (neo-diredy--post-command)
     (should (file-exists-p copy))
     (should neo-diredy--layout-mode)
     (should dired-hide-details-mode)
     (dired-goto-file copy)
     (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) renamed)))
       (dired-do-rename))
     (neo-diredy--post-command)
     (should (file-exists-p renamed))
     (should-not (file-exists-p copy))
     (should neo-diredy--layout-mode)
     (should dired-hide-details-mode)
     (dired-create-directory created)
     (neo-diredy--post-command)
     (should (file-directory-p created))
     (should neo-diredy--layout-mode)
     (should dired-hide-details-mode)
     (dired-goto-file renamed)
     (let ((delete-by-moving-to-trash nil))
       (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
                 ((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
         (dired-do-delete)))
     (neo-diredy--post-command)
     (should-not (file-exists-p renamed))
     (should (file-exists-p file))
     (should neo-diredy--layout-mode)
     (should dired-hide-details-mode))))

(ert-deftest neo-diredy-link-metadata-uses-target ()
  (neo-diredy-test--with-directory
   (let* ((target (expand-file-name "target.txt" root))
          (attributes (file-attributes file))
          (real-attributes (symbol-function 'file-attributes)))
     (with-temp-file target (insert (make-string 150 ?x)))
     (setcar attributes target)
     (cl-letf (((symbol-function 'file-attributes)
                (lambda (path &optional format)
                  (if (equal path file) attributes (funcall real-attributes path format))))
               ((symbol-function 'file-truename) (lambda (_) target)))
       (should (= 150 (file-attribute-size (cdr (neo-diredy--file-info file)))))
       (should (equal target (car (neo-diredy--file-info file))))))))

