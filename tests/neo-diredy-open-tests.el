;;; neo-diredy-open-tests.el --- Opener selection and launch checks -*- lexical-binding: t; -*-
(load (expand-file-name "neo-diredy-tests.el" (file-name-directory load-file-name)) nil t)
(defvar neo-diredy-openers)

(ert-deftest neo-diredy-open-extension-rules ()
  (neo-diredy-test--with-directory
   (let ((system-type 'windows-nt)
         (neo-diredy-openers '(("Images" ("png" "jpg") "paint.exe" nil)
                              ("Archives" ("tar.gz") "archive.exe" ("view"))
                              ("Any item" nil "editor.exe" ("--new-window")))))
     (should (equal (mapcar #'car (neo-diredy--open-choices (expand-file-name "A.PNG" root)))
                    '("Windows default app" "Show in Explorer" "Images" "Any item")))
     (should (equal (mapcar #'car (neo-diredy--open-choices (expand-file-name "a.TAR.GZ" root)))
                    '("Windows default app" "Show in Explorer" "Archives" "Any item")))
     (should (equal (mapcar #'car (neo-diredy--open-choices child))
                    '("Windows default app" "Show in Explorer" "Any item")))
     (should (equal (cdr (assoc "Any item" (neo-diredy--open-choices file)))
                    '("editor.exe" "--new-window"))))))

(ert-deftest neo-diredy-open-invalid-settings-are-reported ()
  (neo-diredy-test--with-directory
   (dolist (entry '(("Bad" ("txt") "program.exe" "not-an-argument-list")
                    ("Bad" (12) "program.exe" nil)
                    ("Bad" ("txt") "" nil)
                    ("Bad" ("txt") "program.exe" (12))
                    ("Incomplete" ("txt"))))
     (let ((neo-diredy-openers (list entry)))
       (should-error (neo-diredy--open-choices file) :type 'user-error)))
   (let ((neo-diredy-openers '(("Same" nil "one.exe" nil)
                              ("Same" nil "two.exe" nil))))
     (should-error (neo-diredy--open-choices file) :type 'user-error))))

(ert-deftest neo-diredy-open-custom-preserves-literal-arguments ()
  (neo-diredy-test--with-directory
   (let ((path (expand-file-name "日本語 空白 & %name%.txt" root))
         (program (expand-file-name invocation-name invocation-directory))
         captured)
     (with-temp-file path (insert "example"))
     (cl-letf (((symbol-function 'make-process)
                (lambda (&rest options) (setq captured options) 'test-process)))
       (neo-diredy--open-file path (list program "--option" "two words")))
     (should (equal (plist-get captured :command)
                    (list program "--option" "two words" path)))
     (should (plist-get captured :noquery)))))

(ert-deftest neo-diredy-open-custom-real-process-receives-one-path ()
  (neo-diredy-test--with-directory
   (let* ((path (expand-file-name "日本語 空白, & %name%.txt" root))
          (output (expand-file-name "arguments.el" root))
          (program (expand-file-name invocation-name invocation-directory))
          (arguments '("" "two words" "a\"b" "C:\\trailing slash\\" "literal & %name%"))
          (expression (prin1-to-string
                       `(progn (with-temp-file ,output
                                 (prin1 (mapcar #'string-to-list command-line-args-left)
                                        (current-buffer)))
                               (setq command-line-args-left nil))))
          process)
     (with-temp-file path (insert "example"))
     (unwind-protect
         (progn
           (let ((coding-system-for-write 'utf-8-unix) (w32-quote-process-args nil))
             (setq process (neo-diredy--open-file
                            path (append (list program "-Q" "--batch" "--eval" expression) arguments))))
           (let ((deadline (+ (float-time) 10)))
             (while (and (process-live-p process) (< (float-time) deadline))
               (accept-process-output process 0.05)))
           (should-not (process-live-p process))
           (should (= (process-exit-status process) 0))
           (should (equal (with-temp-buffer (insert-file-contents output) (read (current-buffer)))
                          (mapcar #'string-to-list (append arguments (list path))))))
       (when (and process (process-live-p process)) (delete-process process))))))

(ert-deftest neo-diredy-open-unrepresentable-windows-path-does-not-launch ()
  (skip-unless (eq system-type 'windows-nt))
  (neo-diredy-test--with-directory
   (let ((path (expand-file-name (concat (string #x1f680) ".txt") root))
         (locale-coding-system 'cp932) launched)
     (with-temp-file path (insert "example"))
     (cl-letf (((symbol-function 'make-process) (lambda (&rest _) (setq launched t)))
               ((symbol-function 'w32-shell-execute) (lambda (&rest _) (setq launched t))))
       (should-error (neo-diredy--open-file path (list (expand-file-name invocation-name invocation-directory)))
                     :type 'user-error)
       (should-error (neo-diredy--open-file path 'explorer) :type 'user-error)
       (should-not launched)))))

(ert-deftest neo-diredy-open-batch-script-does-not-expand-file-names ()
  (neo-diredy-test--with-directory
   (let ((system-type 'windows-nt) launched)
     (cl-letf (((symbol-function 'executable-find) (lambda (_) "C:/tools/opener.cmd"))
               ((symbol-function 'make-process) (lambda (&rest _) (setq launched t))))
       (should-error (neo-diredy--open-file file '("opener.cmd")) :type 'user-error)
       (should-not launched)))))

(ert-deftest neo-diredy-open-windows-actions ()
  (neo-diredy-test--with-directory
   (let ((system-type 'windows-nt)
         (path (expand-file-name "comma,name.txt" root)) shell-call)
     (with-temp-file path (insert "example"))
     (cl-letf (((symbol-function 'w32-shell-execute)
                (lambda (&rest args) (setq shell-call args) 42))
               ((symbol-function 'make-process) (lambda (&rest _) (ert-fail "Unexpected process launch"))))
       (neo-diredy--open-file file 'default)
       (should (equal shell-call (list "open" (subst-char-in-string ?/ ?\\ file))))
       (setq shell-call nil)
       (neo-diredy--open-file child 'explorer)
       (should (equal shell-call (list "explore" (subst-char-in-string ?/ ?\\ child))))
       (neo-diredy--open-file path 'explorer)
       (should (equal shell-call
                      (list "open" (executable-find "explorer.exe")
                            (concat "/select,\"" (subst-char-in-string ?/ ?\\ path) "\""))))))))

(ert-deftest neo-diredy-open-invalid-targets-never-launch ()
  (neo-diredy-test--with-directory
   (let (launched)
     (cl-letf (((symbol-function 'make-process) (lambda (&rest _) (setq launched t)))
               ((symbol-function 'w32-shell-execute) (lambda (&rest _) (setq launched t))))
       (should-error (neo-diredy--open-file (expand-file-name "missing.txt" root) 'default)
                     :type 'user-error)
       (should-error (neo-diredy--open-file "/ssh:host:/file.txt" 'default) :type 'user-error)
       (should-error (neo-diredy--open-file file '("neo-diredy-no-such-program-8127.exe"))
                     :type 'user-error)
       (should-not launched)))))

(ert-deftest neo-diredy-open-command-cancel-does-not-launch ()
  (neo-diredy-test--with-directory
   (dired-goto-file file)
   (cl-letf (((symbol-function 'neo-diredy--read-choice) (lambda (&rest _) nil))
             ((symbol-function 'make-process) (lambda (&rest _) (ert-fail "Unexpected launch")))
             ((symbol-function 'w32-shell-execute) (lambda (&rest _) (ert-fail "Unexpected launch"))))
     (neo-diredy-open))))

(ert-deftest neo-diredy-open-command-rejects-wdired ()
  (neo-diredy-test--with-directory
   (dired-goto-file file)
   (wdired-change-to-wdired-mode)
   (unwind-protect
       (cl-letf (((symbol-function 'neo-diredy--read-choice)
                  (lambda (&rest _) (ert-fail "Opened a menu while renaming"))))
         (should-error (neo-diredy-open) :type 'user-error))
     (wdired-abort-changes))))

(ert-deftest neo-diredy-open-command-uses-the-chosen-action ()
  (neo-diredy-test--with-directory
   (dired-goto-file file)
   (let (opened)
     (cl-letf (((symbol-function 'neo-diredy--read-choice)
                (lambda (target choices)
                  (should (equal target (concat "Open: " (file-name-nondirectory file))))
                  (assoc "Windows default app" choices)))
               ((symbol-function 'w32-shell-execute)
                (lambda (&rest args) (setq opened args))))
       (neo-diredy-open))
     (should (equal opened (list "open" (subst-char-in-string ?/ ?\\ file)))))))

(ert-deftest neo-diredy-open-key-restores-with-layout ()
  (neo-diredy-test--with-directory
   (let ((original (key-binding (kbd "<S-return>")))
         (enter (key-binding (kbd "RET"))))
     (neo-diredy--layout-mode 1)
     (should (eq (key-binding (kbd "<S-return>")) 'neo-diredy-open))
     (should (eq (key-binding (kbd "RET")) enter))
     (neo-diredy--layout-mode -1)
     (should (eq (key-binding (kbd "<S-return>")) original)))))

(ert-deftest neo-diredy-open-child-frame-required ()
  (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) nil)))
    (should-error (neo-diredy--read-choice "file.txt" '(("Open" . default))) :type 'user-error)))

(ert-deftest neo-diredy-open-frame-creation-error-cleans-buffer ()
  (let ((before (buffer-list)) attempted)
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
              ((symbol-function 'make-frame)
               (lambda (&rest _) (setq attempted t) (error "Cannot create frame"))))
      (should-error (neo-diredy--read-choice "file.txt" '(("Open" . default)))))
    (should attempted)
    (should-not (cl-set-difference (buffer-list) before))))

(ert-deftest neo-diredy-open-child-frame-selection-and-cleanup ()
  (skip-unless (display-graphic-p))
  (let ((parent (selected-frame)) (before (frame-list))
        (events '(down return)) popup menu-buffer)
    (cl-letf (((symbol-function 'read-key)
               (lambda (&rest _)
                 (setq popup (car (cl-set-difference (frame-list) before)))
                 (should (eq (frame-parent popup) parent))
                 (should (frame-visible-p popup))
                 (should (eq (selected-frame) parent))
                 (setq menu-buffer (window-buffer (frame-root-window popup)))
                 (with-current-buffer menu-buffer
                   (should (string-match-p "Second" (buffer-string))))
                 (pop events))))
      (should (equal (neo-diredy--read-choice "file.txt" '(("First" . default) ("Second" . explorer)))
                     '("Second" . explorer))))
    (should-not (frame-live-p popup))
    (should-not (buffer-live-p menu-buffer))))

(ert-deftest neo-diredy-open-child-frame-cancel-and-error-cleanup ()
  (skip-unless (display-graphic-p))
  (dolist (event '(escape quit error))
    (let ((before (frame-list)) popup menu-buffer)
      (cl-letf (((symbol-function 'read-key)
                 (lambda (&rest _)
                   (setq popup (car (cl-set-difference (frame-list) before))
                         menu-buffer (window-buffer (frame-root-window popup)))
                   (pcase event ('quit (signal 'quit nil)) ('error (error "Input failure")) (_ event)))))
        (condition-case nil
            (should-not (neo-diredy--read-choice "file.txt" '(("Open" . default))))
          (quit nil) (error (unless (eq event 'error) (ert-fail "Unexpected menu error")))))
      (should-not (frame-live-p popup))
      (should-not (buffer-live-p menu-buffer)))))

(ert-deftest neo-diredy-open-child-frame-hides-tab-line-and-scrolls ()
  (skip-unless (display-graphic-p))
  (let* ((parent (selected-frame)) (before (frame-list))
         (saved-tabs (default-value 'tab-line-format))
         (choices (cl-loop for n below 40 collect
                           (cons (format "Choice %02d %s" n (make-string 100 ?x)) n)))
         (moves 0))
    (unwind-protect
        (progn
          (setq-default tab-line-format '("Unrelated buffer tabs"))
          (cl-letf (((symbol-function 'read-key)
                     (lambda (&rest _)
                       (let* ((popup (car (cl-set-difference (frame-list) before)))
                              (window (frame-root-window popup)))
                         (with-current-buffer (window-buffer window)
                           (should-not tab-line-format))
                         (should (< (frame-pixel-width popup) (frame-pixel-width parent)))
                         (should (< (frame-pixel-height popup) (frame-pixel-height parent)))
                         (if (< moves 39) (progn (cl-incf moves) 'down)
                           (should (pos-visible-in-window-p (window-point window) window))
                           'return)))))
            (should (equal (neo-diredy--read-choice "file.txt" choices) (car (last choices))))))
      (setq-default tab-line-format saved-tabs))))

(ert-deftest neo-diredy-open-child-frame-distinguishes-long-labels ()
  (skip-unless (display-graphic-p))
  (let* ((before (frame-list))
         (prefix (make-string (* 2 (frame-width)) ?x))
         (first (concat prefix " first application"))
         (second (concat prefix " second application"))
         (choices (list (cons first 'default) (cons second 'explorer)))
         (step 0))
    (cl-letf (((symbol-function 'read-key)
               (lambda (&rest _)
                 (let* ((popup (car (cl-set-difference (frame-list) before)))
                        (window (frame-root-window popup)))
                   (with-current-buffer (window-buffer window)
                     (let ((label (if (= step 0) first second)))
                       (should-not truncate-lines)
                       (goto-char (point-min))
                       (search-forward label)
                       (should (pos-visible-in-window-p (1- (point)) window))))
                   (if (= step 0) (progn (setq step 1) 'down) 'return)))))
      (should (equal (neo-diredy--read-choice "file.txt" choices) (cadr choices))))))

(ert-deftest neo-diredy-open-child-frame-real-key-input ()
  (skip-unless (display-graphic-p))
  (neo-diredy-test--with-directory
   (neo-diredy--layout-mode 1)
   (dired-goto-file file)
   (let ((frames (frame-list)) opened)
     (cl-letf (((symbol-function 'w32-shell-execute)
                (lambda (&rest args) (setq opened args))))
       (execute-kbd-macro (kbd "<S-return> <down> <up> RET")))
     (should (equal opened (list "open" (subst-char-in-string ?/ ?\\ file))))
     (should-not (cl-set-difference (frame-list) frames))
     (should neo-diredy--layout-mode)
     (execute-kbd-macro (kbd "<S-return> <escape>"))
     (should-not (cl-set-difference (frame-list) frames))
     (should neo-diredy--layout-mode))))
