(ert-deftest neo-diredy-open-key-restores-with-layout ()
  (neo-diredy-test--with-directory
   (let ((original (key-binding (kbd "<S-return>")))
         (enter (key-binding (kbd "RET"))))
     (neo-diredy--layout-mode 1)
     (should (eq (key-binding (kbd "<S-return>")) 'neo-diredy-open))
     (should (eq (key-binding (kbd "RET")) enter))
     (neo-diredy--layout-mode -1)
     (should (eq (key-binding (kbd "<S-return>")) original)))))

(ert-deftest neo-diredy-open-child-frame-required ()
  (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) nil)))
    (should-error (neo-diredy--read-choice "file.txt" '(("Open" . default))) :type 'user-error)))

(ert-deftest neo-diredy-open-frame-creation-error-cleans-buffer ()
  (let ((before (buffer-list)) attempted)
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
              ((symbol-function 'make-frame)
               (lambda (&rest _) (setq attempted t) (error "Cannot create frame"))))
      (should-error (neo-diredy--read-choice "file.txt" '(("Open" . default)))))
    (should attempted)
    (should-not (cl-set-difference (buffer-list) before))))

(ert-deftest neo-diredy-open-child-frame-selection-and-cleanup ()
  (skip-unless (display-graphic-p))
  (let ((parent (selected-frame)) (before (frame-list))
        (events '(down return)) popup menu-buffer)
    (cl-letf (((symbol-function 'read-key)
               (lambda (&rest _)
                 (setq popup (car (cl-set-difference (frame-list) before)))
                 (should (eq (frame-parent popup) parent))
                 (should (frame-visible-p popup))
                 (should (eq (selected-frame) parent))
                 (setq menu-buffer (window-buffer (frame-root-window popup)))
                 (with-current-buffer menu-buffer
                   (should (string-match-p "Second" (buffer-string))))
                 (pop events))))
      (should (equal (neo-diredy--read-choice "file.txt" '(("First" . default) ("Second" . explorer)))
                     '("Second" . explorer))))
    (should-not (frame-live-p popup))
    (should-not (buffer-live-p menu-buffer))))

(ert-deftest neo-diredy-open-child-frame-cancel-and-error-cleanup ()
  (skip-unless (display-graphic-p))
  (dolist (event '(escape quit error))
    (let ((before (frame-list)) popup menu-buffer)
      (cl-letf (((symbol-function 'read-key)
                 (lambda (&rest _)
                   (setq popup (car (cl-set-difference (frame-list) before))
                         menu-buffer (window-buffer (frame-root-window popup)))
                   (pcase event ('quit (signal 'quit nil)) ('error (error "Input failure")) (_ event)))))
        (condition-case nil
            (should-not (neo-diredy--read-choice "file.txt" '(("Open" . default))))
          (quit nil) (error (unless (eq event 'error) (ert-fail "Unexpected menu error")))))
      (should-not (frame-live-p popup))
      (should-not (buffer-live-p menu-buffer)))))

(ert-deftest neo-diredy-open-child-frame-follows-selected-row ()
  (skip-unless (display-graphic-p))
  (save-window-excursion
    (delete-other-windows)
    (select-window (split-window-right))
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (dotimes (n 100) (insert (format "  Item %02d\n" n)))
      (setq-local header-line-format "Directory" tab-line-format '("Tab"))
      (dolist (row '(2 15 -2))
        (goto-char (point-min)) (forward-line 50) (forward-char 2)
        (recenter row) (redisplay t)
        (let* ((window (selected-window)) (parent (selected-frame))
               (before (frame-list)) (position (point))
               (glyph (posn-at-point))
               (x (+ (car (window-inside-pixel-edges)) (car (posn-x-y glyph))))
               (y (+ (cadr (window-inside-pixel-edges)) (cdr (posn-x-y glyph)))))
          (cl-letf (((symbol-function 'read-key)
                     (lambda (&rest _)
                       (let* ((popup (car (cl-set-difference (frame-list) before)))
                              (xy (frame-position popup)))
                         (should (<= (abs (- (car xy) x)) 2))
                         (if (< row 0)
                             (should (<= (+ (cdr xy) (frame-pixel-height popup)) y))
                           (should (<= (abs (- (cdr xy) (+ y (frame-char-height parent)))) 2)))
                         (should (< (frame-width popup) 30))
                         (should (<= (frame-height popup) 4))
                         (with-current-buffer (window-buffer (frame-root-window popup))
                           (should-not (string-match-p "confirm\\|cancel\\|\n\n" (buffer-string)))))
                       'escape)))
            (neo-diredy--read-choice "Open" '(("Windows default app" . default)
                                                    ("Show in Explorer" . explorer))))
          (should (= (point) position))
          (should (eq (selected-window) window)))))))

(ert-deftest neo-diredy-open-child-frame-hides-tab-line-and-scrolls ()
  (skip-unless (display-graphic-p))
  (let* ((parent (selected-frame)) (before (frame-list))
         (saved-tabs (default-value 'tab-line-format))
         (choices (cl-loop for n below 40 collect
                           (cons (format "Choice %02d %s" n (make-string 100 ?x)) n)))
         (moves 0))
    (unwind-protect
        (progn
          (setq-default tab-line-format '("Unrelated buffer tabs"))
          (cl-letf (((symbol-function 'read-key)
                     (lambda (&rest _)
                       (let* ((popup (car (cl-set-difference (frame-list) before)))
                              (window (frame-root-window popup)))
                         (with-current-buffer (window-buffer window)
                           (should-not tab-line-format))
                         (should (< (frame-pixel-width popup) (frame-pixel-width parent)))
                         (should (< (frame-pixel-height popup) (frame-pixel-height parent)))
                         (if (< moves 39) (progn (cl-incf moves) 'down)
                           (should (pos-visible-in-window-p (window-point window) window))
                           'return)))))
            (should (equal (neo-diredy--read-choice "file.txt" choices) (car (last choices))))))
      (setq-default tab-line-format saved-tabs))))

(ert-deftest neo-diredy-open-child-frame-fits-narrow-frame-right-edge ()
  (skip-unless (display-graphic-p))
  (let ((parent (selected-frame)) (width (frame-width)) (height (frame-height)))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (set-frame-size parent 60 20)
          (with-temp-buffer
            (switch-to-buffer (current-buffer))
            (dotimes (_ 40) (insert (make-string 55 ?x) "\n"))
            (goto-char (point-min)) (forward-line 20) (forward-char 52)
            (recenter -2) (redisplay t)
            (let ((before (frame-list)))
              (cl-letf (((symbol-function 'read-key)
                         (lambda (&rest _)
                           (let* ((popup (car (cl-set-difference (frame-list) before)))
                                  (xy (frame-position popup)))
                             (should (>= (car xy) 0)) (should (>= (cdr xy) 0))
                             (should (<= (+ (car xy) (frame-pixel-width popup)) (frame-pixel-width parent)))
                             (should (<= (+ (cdr xy) (frame-pixel-height popup)) (frame-pixel-height parent))))
                           'escape)))
                (neo-diredy--read-choice "Open" '(("Windows default app" . default)
                                                        ("Show in Explorer" . explorer)))))))
      (set-frame-size parent width height))))

(ert-deftest neo-diredy-open-child-frame-distinguishes-long-labels ()
  (skip-unless (display-graphic-p))
  (let* ((before (frame-list))
         (prefix (make-string (* 2 (frame-width)) ?x))
         (first (concat prefix " first application"))
         (second (concat prefix " second application"))
         (choices (list (cons first 'default) (cons second 'explorer)))
         (step 0))
    (cl-letf (((symbol-function 'read-key)
               (lambda (&rest _)
                 (let* ((popup (car (cl-set-difference (frame-list) before)))
                        (window (frame-root-window popup)))
                   (with-current-buffer (window-buffer window)
                     (let ((label (if (= step 0) first second)))
                       (should-not truncate-lines)
                       (goto-char (point-min))
                       (search-forward label)
                       (should (pos-visible-in-window-p (1- (point)) window))))
                   (if (= step 0) (progn (setq step 1) 'down) 'return)))))
      (should (equal (neo-diredy--read-choice "file.txt" choices) (cadr choices))))))

(ert-deftest neo-diredy-open-child-frame-real-key-input ()
  (skip-unless (display-graphic-p))
  (neo-diredy-test--with-directory
   (neo-diredy--layout-mode 1)
   (dired-goto-file file)
   (let ((frames (frame-list)) opened)
     (cl-letf (((symbol-function 'w32-shell-execute)
                (lambda (&rest args) (setq opened args))))
       (execute-kbd-macro (kbd "<S-return> <down> <up> RET")))
     (should (equal opened (list "open" (subst-char-in-string ?/ ?\\ file))))
     (should-not (cl-remove-if-not #'frame-visible-p (cl-set-difference (frame-list) frames)))
     (should neo-diredy--layout-mode)
     (execute-kbd-macro (kbd "<S-return> <escape>"))
     (should-not (cl-remove-if-not #'frame-visible-p (cl-set-difference (frame-list) frames)))
     (should neo-diredy--layout-mode))))

(ert-deftest neo-diredy-open-child-frame-reuses-native-window ()
  (skip-unless (display-graphic-p))
  (neo-diredy-test--with-directory
   (neo-diredy--layout-mode 1)
   (dired-goto-file file)
   (let ((parent (selected-frame)) (frames (frame-list))
         (directory-windows (get-buffer-window-list (current-buffer) nil t))
         (create (symbol-function 'make-frame)) (creations 0) popup menu-buffer)
     (cl-letf (((symbol-function 'make-frame)
                (lambda (&rest args) (cl-incf creations) (apply create args)))
               ((symbol-function 'read-key)
                (lambda (&rest _)
                  (setq popup (car (cl-set-difference (frame-list) frames))
                        menu-buffer (window-buffer (frame-root-window popup)))
                  (should (eq (frame-parent popup) parent))
                  (should (frame-visible-p popup))
                  (should (eq (selected-frame) parent))
                  'escape)))
       (dotimes (_ 3) (neo-diredy-open)))
     (should (= creations 1))
     (should (frame-live-p popup))
     (should-not (frame-visible-p popup))
     (should (buffer-live-p menu-buffer))
     (should (with-current-buffer menu-buffer (zerop (buffer-size))))
     (should (equal (get-buffer-window-list (current-buffer) nil t) directory-windows))
     (neo-diredy--layout-mode -1)
     (should-not (frame-live-p popup))
     (should-not (buffer-live-p menu-buffer))
     (should-not (cl-set-difference (frame-list) frames)))))

(ert-deftest neo-diredy-open-child-frame-reuse-refreshes-content-and-appearance ()
  (skip-unless (display-graphic-p))
  (neo-diredy-test--with-directory
   (neo-diredy--layout-mode 1)
   (dired-goto-file file)
   (let* ((parent (selected-frame)) (frames (frame-list))
          (font (frame-parameter parent 'font))
          (foreground (frame-parameter parent 'foreground-color))
          (background (frame-parameter parent 'background-color))
          (choices '(("Short" . short))) popup width position)
     (unwind-protect
         (cl-letf (((symbol-function 'read-key)
                    (lambda (&rest _)
                      (let ((current (car (cl-set-difference (frame-list) frames))))
                        (if popup (should (eq current popup)) (setq popup current))
                        (with-current-buffer (window-buffer (frame-root-window popup))
                          (should (string-match-p (regexp-quote (caar choices)) (buffer-string)))))
                      'return)))
           (should (equal (neo-diredy--read-choice "Open" choices) (car choices)))
           (setq width (frame-width popup) position (frame-position popup))
           (set-frame-font (font-spec :family (face-attribute 'default :family parent) :size 16) nil (list parent))
           (modify-frame-parameters parent '((foreground-color . "#ffeedd") (background-color . "#112233")))
           (dired-goto-file child)
           (setq choices '(("A different application with a longer label" . long)))
           (should (equal (neo-diredy--read-choice "Open" choices) (car choices)))
           (should (> (frame-width popup) width))
           (should-not (equal (frame-position popup) position))
           (should (equal (frame-parameter popup 'font) (frame-parameter parent 'font)))
           (should (equal (frame-parameter popup 'foreground-color) (face-foreground 'default parent t)))
           (should (equal (frame-parameter popup 'background-color) (face-background 'default parent t)))
           (setq choices '(("Small" . small)))
           (should (equal (neo-diredy--read-choice "Open" choices) (car choices)))
           (should (= (frame-width popup) width)))
       (set-frame-font font nil (list parent))
       (modify-frame-parameters parent `((foreground-color . ,foreground) (background-color . ,background)))))))

(ert-deftest neo-diredy-open-child-frame-reuse-survives-errors-and-deletion ()
  (skip-unless (display-graphic-p))
  (neo-diredy-test--with-directory
   (neo-diredy--layout-mode 1)
   (let ((frames (frame-list)) popup menu-buffer)
     (dolist (event '(error quit escape))
       (cl-letf (((symbol-function 'read-key)
                  (lambda (&rest _)
                    (setq popup (car (cl-set-difference (frame-list) frames))
                          menu-buffer (window-buffer (frame-root-window popup)))
                    (pcase event ('error (error "Input failure")) ('quit (signal 'quit nil)) (_ event)))))
         (condition-case nil
             (neo-diredy--read-choice "Open" '(("Open" . default)))
           (error (should (eq event 'error))) (quit (should (eq event 'quit)))))
       (should (frame-live-p popup))
       (should-not (frame-visible-p popup))
       (should (buffer-live-p menu-buffer))
       (should (with-current-buffer menu-buffer (zerop (buffer-size)))))
     (delete-frame popup t)
     (let ((unread-command-events '(escape)))
       (neo-diredy--read-choice "Open" '(("Open" . default))))
     (let ((replacement (car (cl-set-difference (frame-list) frames))))
       (should (frame-live-p replacement))
       (should-not (eq replacement popup))
       (neo-diredy-mode -1)
       (should-not (frame-live-p replacement)))
     (should-not (cl-set-difference (frame-list) frames)))))

(ert-deftest neo-diredy-open-child-frame-reuse-changes-parent ()
  (skip-unless (display-graphic-p))
  (neo-diredy-test--with-directory
   (neo-diredy--layout-mode 1)
   (let ((parent (selected-frame)) other first second)
     (unwind-protect
         (progn
           (cl-letf (((symbol-function 'read-key)
                      (lambda (&rest _) (setq first neo-diredy--choice-frame) 'escape)))
             (neo-diredy--read-choice "Open" '(("First" . first))))
           (setq other (make-frame '((visibility . nil))))
           (with-selected-frame other
             (cl-letf (((symbol-function 'read-key)
                        (lambda (&rest _) (setq second neo-diredy--choice-frame) 'escape)))
               (neo-diredy--read-choice "Open" '(("Second" . second)))))
           (should-not (frame-live-p first))
           (should (eq (frame-parent second) other))
           (should-not (frame-visible-p second)))
       (select-frame parent)
       (when (frame-live-p other) (delete-frame other t))))))

(ert-deftest neo-diredy-open-child-frame-nested-menu-preserves-outer ()
  (skip-unless (display-graphic-p))
  (neo-diredy-test--with-directory
   (neo-diredy--layout-mode 1)
   (let ((frames (frame-list)) outer inner)
     (cl-letf (((symbol-function 'read-key)
                (lambda (&rest _)
                  (setq outer neo-diredy--choice-frame)
                  (cl-letf (((symbol-function 'read-key)
                             (lambda (&rest _)
                               (setq inner (car (cl-set-difference (frame-list) (cons outer frames))))
                               (should (frame-visible-p outer))
                               (should (frame-visible-p inner))
                               'return)))
                    (should (equal (neo-diredy--read-choice "Inner" '(("Second" . second))) '("Second" . second))))
                  (should-not (frame-live-p inner))
                  (should (frame-visible-p outer))
                  'escape)))
       (neo-diredy--read-choice "Outer" '(("First" . first))))
     (should (frame-live-p outer))
     (should-not (frame-visible-p outer)))))
