;;; neo-diredy-evil-tests.el --- Optional real Evil key tests -*- lexical-binding: t; -*-
;; Uses existing packages read-only; never loads user init or installs anything.
;; Set NEO_DIREDY_TEST_ELPA, or use the sibling emacs.d/elpa checkout.
(load (expand-file-name "neo-diredy-tests.el" (file-name-directory load-file-name)) nil t)
(defvar evil-want-keybinding)
(defvar evil-collection-want-unimpaired-p)
(let ((directory (or (getenv "NEO_DIREDY_TEST_ELPA")
                     (expand-file-name "../../emacs.d/elpa" (file-name-directory load-file-name)))))
  (when (file-directory-p directory)
    (dolist (path (directory-files directory t "\\`\\(?:evil-\\|goto-chg-\\)"))
      (when (file-directory-p path) (add-to-list 'load-path path)))))

(ert-deftest neo-diredy-evil-insert-and-normal-keep-layout ()
  (skip-unless (and (locate-library "evil") (locate-library "evil-collection")))
  (setq evil-want-keybinding nil evil-collection-want-unimpaired-p nil)
  (require 'evil)
  (require 'evil-collection)
  (evil-collection-init '(dired))
  (evil-mode 1)
  (unwind-protect
      (neo-diredy-test--with-directory
       (neo-diredy--layout-mode 1)
       (dired-goto-file file)
       (evil-normal-state)
       (should (eq (key-binding (kbd "i")) 'dired-toggle-read-only))
       (execute-kbd-macro (kbd "i"))
       (should (eq major-mode 'wdired-mode))
       (should (evil-insert-state-p))
       (should neo-diredy--layout-mode)
       (execute-kbd-macro (kbd "<insert>"))
       (should (evil-replace-state-p))
       (should neo-diredy--layout-mode)
       (should dired-hide-details-mode)
       (execute-kbd-macro (kbd "<insert>"))
       (should (evil-insert-state-p))
       (should neo-diredy--layout-mode)
       (should dired-hide-details-mode)
       (should cursor-type)
       (execute-kbd-macro "renamed-")
       (execute-kbd-macro (kbd "<escape>"))
       (should (eq major-mode 'wdired-mode))
       (should (evil-normal-state-p))
       (should (eq (get-text-property 0 'face (eval (cadr header-line-format) t)) 'warning))
       (should neo-diredy--layout-mode)
       (should dired-hide-details-mode)
       (wdired-finish-edit)
       (neo-diredy--post-command)
       (should (file-exists-p (expand-file-name "renamed-hello.txt" root)))
       (should neo-diredy--layout-mode)
       (should (= (+ 4 (if (window-live-p neo-diredy--details-window) 1 0)) (length (window-list))))
       (dolist (state '(evil-normal-state evil-visual-state evil-emacs-state evil-normal-state))
         (funcall state)
         (neo-diredy--post-command)
         (should neo-diredy--layout-mode)
         (should dired-hide-details-mode)))
    (evil-mode -1)))

(ert-deftest neo-diredy-evil-opener-key-only-in-layout ()
  (skip-unless (and (locate-library "evil") (locate-library "evil-collection")))
  (setq evil-want-keybinding nil evil-collection-want-unimpaired-p nil)
  (require 'evil)
  (require 'evil-collection)
  (evil-collection-init '(dired))
  (evil-mode 1)
  (unwind-protect
      (neo-diredy-test--with-directory
       (evil-normal-state)
       (let ((original (key-binding (kbd "<S-return>")))
             (enter (key-binding (kbd "RET"))))
         (neo-diredy--layout-mode 1)
         (should (eq (key-binding (kbd "<S-return>")) 'neo-diredy-open))
         (should (eq (key-binding (kbd "RET")) enter))
         (neo-diredy--layout-mode -1)
         (should (eq (key-binding (kbd "<S-return>")) original))))
    (evil-mode -1)))

(ert-deftest neo-diredy-evil-workflow-keys-and-preview-return ()
  (skip-unless (and (locate-library "evil") (locate-library "evil-collection")))
  (setq evil-want-keybinding nil evil-collection-want-unimpaired-p nil)
  (require 'evil)
  (require 'evil-collection)
  (evil-collection-init '(dired))
  (evil-mode 1)
  (unwind-protect
      (neo-diredy-test--with-directory
       (evil-normal-state)
       (let* ((bindings '(("C-c b a" . neo-diredy-bookmark-add)
                          ("C-c b j" . neo-diredy-bookmark-jump)
                          ("C-c b d" . neo-diredy-bookmark-delete)
                          ("M-<down>" . neo-diredy-preview-scroll-up)
                          ("M-<up>" . neo-diredy-preview-scroll-down)
                          ("C-c p" . neo-diredy-preview-expand)))
              (before (mapcar (lambda (entry) (key-binding (kbd (car entry)))) bindings)))
         (neo-diredy--layout-mode 1)
         (dolist (entry bindings) (should (eq (key-binding (kbd (car entry))) (cdr entry))))
         (dired-goto-file file)
         (neo-diredy-preview-expand)
         (evil-normal-state)
         (should (eq (key-binding "q") 'neo-diredy-preview-close))
         (execute-kbd-macro "q")
         (should (neo-diredy--layout-intact-p))
         (neo-diredy--layout-mode -1)
         (should (equal before (mapcar (lambda (entry) (key-binding (kbd (car entry)))) bindings)))))
    (evil-mode -1)))

(ert-deftest neo-diredy-evil-a-appends-name-only-in-layout ()
  (skip-unless (and (locate-library "evil") (locate-library "evil-collection")))
  (setq evil-want-keybinding nil evil-collection-want-unimpaired-p nil)
  (require 'evil)
  (require 'evil-collection)
  (evil-collection-init '(dired))
  (evil-mode 1)
  (unwind-protect
      (neo-diredy-test--with-directory
       (evil-normal-state)
       (let ((original (key-binding (kbd "a"))))
         (neo-diredy--layout-mode 1)
         (dired-goto-file file)
         (should-not (eq (key-binding (kbd "a")) 'dired-find-alternate-file))
         (execute-kbd-macro (kbd "a"))
         (should (eq major-mode 'wdired-mode))
         (should (evil-insert-state-p))
         (execute-kbd-macro "X")
         (execute-kbd-macro (kbd "<escape> a Y <escape>"))
         (execute-kbd-macro (kbd "C-c C-c"))
         (should (file-exists-p (expand-file-name "hXYello.txt" root)))
         (should neo-diredy--layout-mode)
         (neo-diredy--layout-mode -1)
         (should (eq (key-binding (kbd "a")) original))))
    (evil-mode -1)))
