;;; check-package.el --- Compile without writing bytecode -*- lexical-binding: t; -*-
(require 'bytecomp)
(require 'package)
(let* ((source (expand-file-name "../neo-diredy.el" (file-name-directory load-file-name)))
       (byte-compile-current-file source)
       (byte-compile-error-on-warn t)
       (diagnostics nil))
  (with-temp-buffer
    (insert-file-contents source)
    (let ((descriptor (package-buffer-info)))
      (unless (and (eq (package-desc-name descriptor) 'neo-diredy)
                   (equal (package-desc-reqs descriptor) '((emacs (29 1)))))
        (error "Unexpected package metadata")))
    (cl-letf (((symbol-function 'byte-compile-log-warning)
               (lambda (message &rest _)
                 (push message diagnostics))))
      (byte-compile-from-buffer (current-buffer))))
  (when diagnostics (error "Compiler diagnostics: %S" diagnostics))
  (load source nil t)
  (unless (bound-and-true-p neo-diredy-mode) (error "Package did not enable automatically"))
  (unload-feature 'neo-diredy t)
  (when (advice-member-p 'neo-diredy--auto-enable 'dired)
    (error "Package left advice behind after unload"))
  (princ "NEO_DIREDY_PACKAGE=PASS\n"))
